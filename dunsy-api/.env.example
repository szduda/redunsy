# Required for every route except GET /health (and /docs in non-production).
DUNSY_API_INTERNAL_KEY=

# Comma-separated frontend origins. If a request carries Origin equal to one of
# these (or a *.vercel.app preview), the API returns 403 — browsers must not call us.
DUNSY_ALLOWED_BROWSER_ORIGINS=https://re.dunsy.app,http://localhost:3000

# Canonical public URL of this API (docs / logs). Not used for authentication.
DUNSY_API_PUBLIC_URL=http://localhost:3001

# Same allowlist as the Next.js app. Admin = email match, not a DB role.
ADMIN_EMAILS=

# Same Postgres as the Next.js app. Optional for the connection slice; /ready pings it when set.
POSTGRES_URL=

# Optional. Signed BFF JWT later; unused in the connection slice.
DUNSY_API_JWT_SECRET=
